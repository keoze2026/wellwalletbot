# Telegram Bot token from @BotFather
BOT_TOKEN=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Admin Telegram user IDs (comma-separated) — only these can run /stop
ADMIN_IDS=

# Wallet API — used by the /topup command
# prod: https://tag.alfa-bot.com/api/prod/v1   dev: https://tag.dev.alfa-bot.com/api/dev/v1
# Use whichever environment your server IP is allowlisted for.
WALLET_API_BASE_URL=https://tag.alfa-bot.com/api/prod/v1
# API key sent in the "token" header
WALLET_API_TOKEN=
# Wallet type for /topup deposits: "accounting" = exchange wallet, "user" = private wallet
WALLET_TYPE=accounting

# Wallet pruning — the provider caps the account at 500 wallets, and POST
# /wallets starts returning 404 once that cap is hit. Above the threshold, the
# bot deletes the OLDEST wallets back down to it.
#
# WARNING: balance and age are NOT checked. A wallet still holding USDT will be
# deleted, and the provider says those funds are then recoverable only by
# contacting their support team. Only wallets this bot created (named
# tg-<userId>-<epochMs>) are touched, because the API returns no timestamp and
# the name is the only way to order by age.
WALLET_PRUNE_ENABLED=true
# Set true to log what WOULD be deleted without deleting it
WALLET_PRUNE_DRY_RUN=false
# Prune only when the account holds more than this many wallets
WALLET_PRUNE_THRESHOLD=350
# Ceiling on how many wallets a single sweep may delete
WALLET_PRUNE_MAX_PER_RUN=200
# How often to sweep
WALLET_PRUNE_INTERVAL_HOURS=6

# Transaction-notification webhook (the provider POSTs deposits/withdrawals here)
WEBHOOK_PORT=8080
# Include a hard-to-guess secret in the path; this IS the auth
WEBHOOK_PATH=/webhook/CHANGE_ME_to_a_long_random_string
# Which events to email about: "in" (deposit), "out" (withdrawal), or "in,out"
NOTIFY_DIRECTIONS=in,out

# Email (SMTP) for transaction alerts — leave SMTP_HOST/MAIL_TO blank to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
